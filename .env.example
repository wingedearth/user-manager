# URL of the united-api GraphQL endpoint that user-manager talks to.
# Populated automatically by the dev:local / dev:remote (and build:local /
# build:remote) npm scripts; only needed here if you run `next dev`/`next build`
# directly instead of through those scripts.
#
# Local united-api instance (default port 4000):
# NEXT_PUBLIC_UNITED_API_URL=http://localhost:4000/graphql
#
# Deployed united-api instance:
# NEXT_PUBLIC_UNITED_API_URL=https://wingedearth-united-api-76c9d860a852.herokuapp.com/graphql
NEXT_PUBLIC_UNITED_API_URL=http://localhost:4000/graphql
